# Link State Routing Algorithm (Dijkstra) without sys module

INF = 9999

def dijkstra(graph, start):
    n = len(graph)
    visited = [False] * n
    distance = [INF] * n
    distance[start] = 0

    for _ in range(n):
        min_node = -1
        for i in range(n):
            if not visited[i] and (min_node == -1 or distance[i] < distance[min_node]):
                min_node = i

        visited[min_node] = True

        for j in range(n):
            if graph[min_node][j] != 0 and distance[j] > distance[min_node] + graph[min_node][j]:
                distance[j] = distance[min_node] + graph[min_node][j]

    return distance

n = int(input("Enter number of nodes: "))
print("Enter cost adjacency matrix (0 for no link):")
graph = []
for i in range(n):
    graph.append(list(map(int, input().split())))

for i in range(n):
    dist = dijkstra(graph, i)
    print("Shortest path from node", i, ":", dist)

